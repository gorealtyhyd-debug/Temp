# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Srinivasa Ramanujan Foundation"

# Database — local Microsoft SQL Server only (no Docker)
# Use a SQL login (sa or another SQL user). Windows Authentication is not supported by Prisma 7.
# If the password contains special characters, wrap it in curly braces: password={MyP@ssw0rd}
# Named instance example (SQL Express): sqlserver://localhost\\SQLEXPRESS;database=srf_olympiad;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=srf_olympiad;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

# Auth
AUTH_SECRET="replace-with-long-random-secret"

# Payment gateway (Razorpay-compatible architecture — server only)
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# Settlement UPI is configured in the gateway merchant dashboard (not trusted from the browser)
# Organization reference UPI: pavanchinna53@okicici

# Notifications
SMS_API_KEY=""
EMAIL_API_KEY=""
EMAIL_FROM="noreply@srmoe.com"

# Analytics (optional)
NEXT_PUBLIC_GTM_ID=""
