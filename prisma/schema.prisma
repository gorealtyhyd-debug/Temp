generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// SQL Server has no Prisma enums or Json type. Status/role values are stored as NVARCHAR.
// Canonical values live in src/lib/db-enums.ts.

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  mobile       String?   @unique
  passwordHash String?
  name         String?
  role         String    @default("STUDENT") @db.NVarChar(32)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      Student?
  schoolUsers  SchoolUser[]
  auditLogs    AuditLog[]
  notifications Notification[]
}

model OtpChallenge {
  id        String   @id @default(cuid())
  mobile    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile])
}

model Student {
  id              String    @id @default(cuid())
  userId          String    @unique
  fullName        String
  dateOfBirth     DateTime?
  gender          String?   @db.NVarChar(16)
  classLevel      String?
  section         String?
  academicYear    String?
  mobile          String?
  parentName      String?
  parentMobile    String?
  email           String?
  photoUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations   Registration[]
  hallTickets     HallTicket[]
  results         Result[]
  certificates    Certificate[]
}

model School {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique
  address      String?  @db.NVarChar(Max)
  villageCity  String?
  mandal       String?
  district     String?
  state        String?
  pincode      String?
  phone        String?
  email        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users          SchoolUser[]
  registrations  Registration[]
}

model SchoolUser {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  role      String   @default("COORDINATOR") @db.NVarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
}

model Olympiad {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  code                 String         @unique
  name                 String
  shortName            String
  tagline              String?
  description          String          @db.NVarChar(Max)
  eligibleClasses      String
  examPattern          String?         @db.NVarChar(Max)
  level1Date           DateTime?
  level2Date           DateTime?
  registrationDeadline DateTime?
  feePaise             Int
  discountPaise        Int            @default(0)
  status               String         @default("DRAFT") @db.NVarChar(32)
  seoTitle             String?
  seoDescription       String?         @db.NVarChar(Max)
  ogImageUrl           String?
  syllabusUrl          String?
  sortOrder            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  registrationItems RegistrationItem[]
  hallTickets       HallTicket[]
  results           Result[]
  certificates      Certificate[]
}

model Registration {
  id                 String             @id @default(cuid())
  registrationNumber String?            @unique
  type               String             @default("INDIVIDUAL") @db.NVarChar(32)
  status             String             @default("DRAFT") @db.NVarChar(32)
  studentId          String?
  schoolId           String?
  academicYear       String
  subtotalPaise      Int                @default(0)
  discountPaise      Int                @default(0)
  totalPaise         Int                @default(0)
  confirmedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  student  Student?           @relation(fields: [studentId], references: [id])
  school   School?            @relation(fields: [schoolId], references: [id])
  items    RegistrationItem[]
  payments Payment[]
}

model RegistrationItem {
  id             String   @id @default(cuid())
  registrationId String
  olympiadId     String
  feePaise       Int
  classLevel     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  olympiad     Olympiad     @relation(fields: [olympiadId], references: [id])

  @@unique([registrationId, olympiadId])
}

model Payment {
  id                String        @id @default(cuid())
  registrationId    String
  amountPaise       Int
  currency          String        @default("INR")
  status            String        @default("CREATED") @db.NVarChar(32)
  gateway           String        @default("razorpay")
  gatewayOrderId    String?       @unique
  gatewayPaymentId  String?
  gatewaySignature  String?
  method            String?
  receiptUrl        String?
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  registration Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id               String        @id @default(cuid())
  paymentId        String
  status           String        @db.NVarChar(32)
  rawPayload       String?       @db.NVarChar(Max)
  gatewayEventId   String?
  createdAt        DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model ExamCentre {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  address   String   @db.NVarChar(Max)
  city      String?
  district  String?
  state     String?
  pincode   String?
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hallTickets HallTicket[]
}

model HallTicket {
  id               String        @id @default(cuid())
  hallTicketNumber String        @unique
  registrationId   String?
  studentId        String
  olympiadId       String
  examCentreId     String?
  examDate         DateTime?
  examTime         String?
  examLevel        String?
  qrToken          String        @unique
  status           String        @default("DRAFT") @db.NVarChar(32)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student    Student     @relation(fields: [studentId], references: [id])
  olympiad   Olympiad    @relation(fields: [olympiadId], references: [id])
  examCentre ExamCentre? @relation(fields: [examCentreId], references: [id])
}

model Result {
  id               String        @id @default(cuid())
  studentId        String
  olympiadId       String
  registrationId   String?
  marksObtained    Float
  totalMarks       Float
  percentage       Float
  rank             Int?
  qualification    String?
  status           String        @default("DRAFT") @db.NVarChar(32)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  olympiad Olympiad @relation(fields: [olympiadId], references: [id])

  @@index([studentId, olympiadId])
}

model Certificate {
  id                String        @id @default(cuid())
  certificateNumber String        @unique
  studentId         String
  olympiadId        String
  academicYear      String
  achievement       String
  rank              Int?
  qrToken           String        @unique
  issueDate         DateTime      @default(now())
  status            String        @default("DRAFT") @db.NVarChar(32)
  fileUrl           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  olympiad Olympiad @relation(fields: [olympiadId], references: [id])
}

model Announcement {
  id          String        @id @default(cuid())
  title       String
  body        String        @db.NVarChar(Max)
  ctaLabel    String?
  ctaHref     String?
  isPinned    Boolean       @default(false)
  status      String        @default("DRAFT") @db.NVarChar(32)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Download {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.NVarChar(Max)
  category    String?
  fileUrl     String
  status      String        @default("DRAFT") @db.NVarChar(32)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GalleryItem {
  id          String        @id @default(cuid())
  title       String
  caption     String?       @db.NVarChar(Max)
  imageUrl    String
  category    String?
  status      String        @default("DRAFT") @db.NVarChar(32)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Award {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.NVarChar(Max)
  year        String?
  imageUrl    String?
  status      String        @default("DRAFT") @db.NVarChar(32)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Topper {
  id          String        @id @default(cuid())
  studentName String
  olympiad    String
  classLevel  String?
  school      String?
  rank        Int?
  year        String?
  photoUrl    String?
  status      String        @default("DRAFT") @db.NVarChar(32)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Faq {
  id          String        @id @default(cuid())
  question    String
  answer      String        @db.NVarChar(Max)
  category    String?
  sortOrder   Int           @default(0)
  status      String        @default("DRAFT") @db.NVarChar(32)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.NVarChar(Max)
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String?  @db.NVarChar(Max)
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.NVarChar(Max)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
